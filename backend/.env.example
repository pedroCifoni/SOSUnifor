# Desenvolvimento local. Nunca publique estas credenciais.
AMBIENTE=desenvolvimento
DATABASE_URL=postgresql+psycopg://unisos:uni12345@localhost:5433/unisos
JWT_SECRET=chave-exclusiva-para-desenvolvimento-local-nao-publicar
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Pool de conexões ao banco, por processo/worker da API.
# Total de conexões possíveis = (DB_POOL_SIZE + DB_MAX_OVERFLOW) x número de processos.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# Segundos esperando uma conexão livre do pool antes de responder erro.
DB_POOL_TIMEOUT=10
# Segundos até reciclar uma conexão (o Neon encerra conexões ociosas).
DB_POOL_RECYCLE=300
# Use false se o pooler em modo transação (PgBouncer/Neon "-pooler") reclamar de prepared statements.
DB_PREPARED_STATEMENTS=true

# Neon (produção):
#   DATABASE_URL        -> endpoint COM "-pooler" (ex.: ep-xxx-pooler.sa-east-1.aws.neon.tech), usado pelas requisições.
#   DATABASE_URL_DIRETA -> o MESMO banco pelo endpoint SEM "-pooler" (ex.: ep-xxx.sa-east-1.aws.neon.tech).
#                          Usado só pelo ouvinte de tempo real, pois LISTEN não funciona através do pooler.
#                          Vazio = usa DATABASE_URL.
DATABASE_URL_DIRETA=

# Avisos em tempo real (WebSocket) entre várias instâncias/workers da API, via Postgres LISTEN/NOTIFY.
# false: cada processo avisa só as suas conexões (basta com uma instância e um worker).
# true:  o aviso é publicado no banco e todas as instâncias o entregam.
#        Custo: cada instância mantém UMA conexão sempre aberta (DATABASE_URL_DIRETA), o que
#        impede o Neon de suspender o banco (scale to zero) enquanto a API estiver ligada.
TEMPO_REAL_DISTRIBUIDO=false

# Endereço do front-end, usado nos links enviados por e-mail (ex.: redefinição de senha).
FRONTEND_URL=http://localhost:5173

# E-mail (SMTP). Em desenvolvimento, o Mailpit do docker-compose recebe tudo: http://localhost:8025
# Em produção, use o SMTP do provedor (ex.: smtp.gmail.com:587 com senha de app, SendGrid, Amazon SES).
# Sem SMTP_HOST, os e-mails só aparecem no log da API.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=Uni SOS <nao-responda@unisos.local>
SMTP_STARTTLS=false
SMTP_SSL=false
