# Desenvolvimento local. Nunca publique estas credenciais.
AMBIENTE=desenvolvimento
DATABASE_URL=postgresql+psycopg://unisos:uni12345@localhost:5433/unisos
JWT_SECRET=chave-exclusiva-para-desenvolvimento-local-nao-publicar
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Pool de conexões ao banco, por processo/worker da API.
# Total de conexões possíveis = (DB_POOL_SIZE + DB_MAX_OVERFLOW) x número de processos.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# Segundos esperando uma conexão livre do pool antes de responder erro.
DB_POOL_TIMEOUT=10
# Segundos até reciclar uma conexão (o Neon encerra conexões ociosas).
DB_POOL_RECYCLE=300
# Use false se o pooler em modo transação (PgBouncer/Neon "-pooler") reclamar de prepared statements.
DB_PREPARED_STATEMENTS=true

# Neon (produção): use em DATABASE_URL o endpoint COM "-pooler" (ex.: ep-xxx-pooler.sa-east-1.aws.neon.tech).

# Mensageria: aviso em tempo real (WebSocket) entre as instâncias da API, via RabbitMQ.
# Sem RabbitMQ disponível, a API continua funcionando e avisa só as conexões do próprio processo.
# Em produção, use um RabbitMQ hospedado (ex.: CloudAMQP) com amqps://.
RABBITMQ_URL=amqp://unisos:uni12345@localhost:5672/


# Endereço do front-end, usado nos links enviados por e-mail (ex.: redefinição de senha).
FRONTEND_URL=http://localhost:5173

# E-mail (SMTP). Em desenvolvimento, o Mailpit do docker-compose recebe tudo: http://localhost:8025
# Em produção, use o SMTP do provedor (ex.: smtp.gmail.com:587 com senha de app, SendGrid, Amazon SES).
# Sem SMTP_HOST, os e-mails só aparecem no log da API.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=Uni SOS <nao-responda@unisos.local>
SMTP_STARTTLS=false
SMTP_SSL=false

# Produção no plano gratuito do Render: as portas de SMTP (25, 465, 587) são bloqueadas.
# Use a API HTTP da Brevo (gratuita, 300 e-mails/dia): crie a chave em https://app.brevo.com/settings/keys/api
# e verifique o remetente de SMTP_REMETENTE na Brevo. Com BREVO_API_KEY preenchida, o SMTP é ignorado.
BREVO_API_KEY=

# LGPD: prazos da rotina de retenção, executada a cada subida da API (veja docs/LGPD.md).
# ATENÇÃO: a Política de Privacidade (src/pages/Privacidade/PrivacidadePage.tsx) informa ao titular
# "180 dias" para notificações lidas e "30 minutos" para os links de redefinição de senha
# (REDEFINICAO_SENHA_EXPIRA_MINUTOS). Ao mudar esses prazos, atualize o texto da política e aumente
# VERSAO_TERMOS no back e no front (transparência, art. 9º da LGPD).
RETENCAO_NOTIFICACOES_LIDAS_DIAS=180
RETENCAO_TOKENS_VENCIDOS_HORAS=24
