# Variáveis locais do Docker Compose.
POSTGRES_PORT=5433
POSTGRES_USER=unisos
POSTGRES_PASSWORD=uni12345
POSTGRES_DB=unisos

# URL base da API para o front-end.
# Variáveis VITE_* ficam públicas no bundle. Nunca coloque segredos aqui.
VITE_API_URL=http://127.0.0.1:8000

# SOS: por padrão usa um ponto fixo dentro da UNIFOR (Bloco C), para testes fora do campus.
# Defina como true para usar o GPS real do dispositivo.
# VITE_SOS_USAR_GPS=true

# Opcional: estilo do provedor de mapas escolhido pela instituição.
# Sem esta variável, o sistema usa um estilo público apenas para desenvolvimento.
# VITE_MAP_STYLE_URL=https://seu-provedor-de-mapas/estilo.json
